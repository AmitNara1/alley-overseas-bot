# ──────────────────────────────────────────────────────────────
# GUPSHUP CREDENTIALS
# Get these from: https://app.gupshup.io → Your App → Settings
# ──────────────────────────────────────────────────────────────

# Your Gupshup API Key
GUPSHUP_API_KEY=your_api_key_here

# The app name you created on Gupshup dashboard
GUPSHUP_APP_NAME=AlleyOverseas

# Your WhatsApp Business number linked to Gupshup
# Format: country code + number, NO + sign, NO spaces
# Example: 919876543210  (for +91 98765 43210)
GUPSHUP_SOURCE=919876543210

# ──────────────────────────────────────────────────────────────
# GOOGLE SHEETS (optional but recommended)
# Skip these two if you only want CSV file leads
# ──────────────────────────────────────────────────────────────

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Paste your entire service-account JSON on ONE LINE (minified)
# Get this from: Google Cloud Console → IAM → Service Accounts → Keys → JSON
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"..."}
